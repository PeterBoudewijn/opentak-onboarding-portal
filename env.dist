# ===================
# Required Settings
# ===================
SECRET_KEY=dev
JWT_SECRET_KEY=dev

# OpenTAK Server Connection
OTS_USERNAME=administrator
OTS_PASSWORD=password
OTS_URL=https://host.docker.internal
OTS_VERIFY_SSL=False

# ===================
# Application
# ===================
DEBUG=False
SQLALCHEMY_DATABASE_URI=sqlite:///db.sqlite
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=*

# ===================
# Email (Optional)
# ===================
MAIL_ENABLED=False
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=username
MAIL_PASSWORD=password
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_DEFAULT_SENDER=no-reply@example.com

# ===================
# Storage Paths
# ===================
DATAPACKAGE_UPLOAD_FOLDER=datapackages
UPDATES_UPLOAD_FOLDER=updates


# Airsoft game permanent membership examples
# Full team members: IN + OUT
GAME_PERMANENT_USERS_RED=
GAME_PERMANENT_USERS_BLUE=
# Watch-only observers: OUT only
GAME_PERMANENT_OBSERVERS_RED=
GAME_PERMANENT_OBSERVERS_BLUE=

# OTS identities represented by administrator-managed CO portal QR codes
GAME_CO_PORTAL_USERNAME_RED=CORood
GAME_CO_PORTAL_USERNAME_BLUE=COBLauw
